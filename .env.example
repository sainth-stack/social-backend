# ──────────────────────────────────────────────────────────────────────────────
# OpsBrain AI — Social Media Manager Backend — Environment Variables
# Copy to .env and fill in every value before running the API or workers.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="OpsBrain AI Social Media Manager"
DEBUG=false
JSON_LOGS=false
API_V1_PREFIX=/api/v1
# This service's frontend runs on 3001 by default (OpsBrain's main frontend uses 3000).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Platform admin bootstrap (created automatically on first startup) ────────
ADMIN_EMAIL=admin@opsbrainai.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD


# ── Database — PostgreSQL ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://opsbrain:password@localhost:5432/opsbrain_social
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10


# ── Cache / Queue — Redis (Celery broker + result backend) ───────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ── LLM — Azure OpenAI (chat / text generation) ───────────────────────────────
# Portal → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# ── Image Generation — Azure OpenAI gpt-image-2 (GA) ─────────────────────────
# Deploy "gpt-image-2" in Azure AI Foundry and set the deployment name below.
# api-version must be "preview" for gpt-image-2.
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_VERSION=preview

# ── Video Generation — Azure OpenAI Sora 2 (gated preview) ───────────────────
# Sora 2 requires applying for access: https://aka.ms/oai/sora2access
# Deploy "sora-2" in Azure AI Foundry; may require a different resource endpoint.
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora-2
AZURE_OPENAI_VIDEO_API_VERSION=preview
AZURE_OPENAI_VIDEO_ENDPOINT=
AZURE_OPENAI_VIDEO_API_KEY=
VIDEO_GENERATION_ENABLED=true


# ── Object Storage — Azure Blob Storage (post images/videos) ─────────────────
# Portal → Storage account → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_ACCOUNT_KEY=<storage-account-key>
AZURE_STORAGE_CONTAINER_NAME=opsbrain-social
AZURE_STORAGE_PREFIX=social


# ── Meta (Facebook + Instagram) OAuth ─────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v19.0
# Use {platform} placeholder — resolved to "facebook" / "instagram" at runtime.
# Must match the port uvicorn is running on (default 8001). Also add this exact
# URL (with facebook / instagram) in Meta Developer → Valid OAuth Redirect URIs.
META_SOCIAL_REDIRECT_URI=http://localhost:8001/api/v1/social/oauth/{platform}/callback
# Instagram Login product credentials (Meta → Instagram use case → API setup).
# Not the same as META_APP_ID (Facebook).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# HTTPS only — Instagram Business Login rejects http://localhost.
# Local: ngrok http 8001 → paste https://xxxx.ngrok-free.app/api/v1/social/oauth/instagram/callback
# Must match Meta Developer → Instagram app → Valid OAuth Redirect URIs exactly.
META_INSTAGRAM_REDIRECT_URI=

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/api/v1/social/oauth/linkedin/callback
# true only after Community Management API is approved (Company Pages).
LINKEDIN_ORGANIZATION_SCOPES=false

# ── X (Twitter) OAuth 2.0 PKCE ─────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8001/api/v1/social/oauth/x/callback

# ── Email — Resend (same keys as OpsBrain-Backend) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@opsbrainai.com

# ── Misc ────────────────────────────────────────────────────────────────────────
DEFAULT_WORKSPACE_TIMEZONE=Asia/Kolkata
