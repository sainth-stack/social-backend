# ──────────────────────────────────────────────────────────────────────────────
# OpsBrain AI — Social Media Manager Backend — Environment Variables
# Copy to .env and fill in every value before running the API or workers.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="OpsBrain AI Social Media Manager"
DEBUG=false
JSON_LOGS=false
API_V1_PREFIX=/api/v1
# This service's frontend runs on 3001 by default (OpsBrain's main frontend uses 3000).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080
# Google OAuth — user sign-in (Google Cloud Console → OAuth 2.0 Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local API callback (port 8000). Production: leave blank to auto-use FRONTEND_URL + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Platform admin bootstrap (created automatically on first startup) ────────
ADMIN_EMAIL=admin@opsbrainai.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD


# ── Database — MongoDB ────────────────────────────────────────────────────────
# Quote the URL — query string contains & which breaks bash if you "source .env"
MONGODB_URL="mongodb+srv://USER:PASSWORD@cluster0.gmxleae.mongodb.net/testing-social?retryWrites=true&w=majority"
MONGODB_DB_NAME=testing-social


# ── Cache / Queue — Redis (Celery broker + result backend) ───────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ── LLM — OpenAI (chat / image generation) ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEPLOYMENT=gpt-4o-mini
OPENAI_IMAGE_DEPLOYMENT=dall-e-3
VIDEO_GENERATION_ENABLED=false


# ── Object Storage — Amazon S3 ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_STORAGE_PREFIX=peers


# ── Meta (Facebook + Instagram) OAuth ─────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v19.0
# Use {platform} placeholder — resolved to "facebook" / "instagram" at runtime.
# Must match the port uvicorn is running on (default 8000). Also add this exact
# URL (with facebook / instagram) in Meta Developer → Valid OAuth Redirect URIs.
META_SOCIAL_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/{platform}/callback
# Instagram Login product credentials (Meta → Instagram use case → API setup).
# Not the same as META_APP_ID (Facebook).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# HTTPS only — Instagram Business Login rejects http://localhost.
# Local: ngrok http 8000 → paste https://xxxx.ngrok-free.app/api/v1/social/oauth/instagram/callback
# Must match Meta Developer → Instagram app → Valid OAuth Redirect URIs exactly.
META_INSTAGRAM_REDIRECT_URI=

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/linkedin/callback
# true only after Community Management API is approved (Company Pages).
LINKEDIN_ORGANIZATION_SCOPES=false

# ── X (Twitter) OAuth 2.0 PKCE ─────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/x/callback

# ── Email — Resend (same keys as OpsBrain-Backend) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@opsbrainai.com

# ── Misc ────────────────────────────────────────────────────────────────────────
DEFAULT_WORKSPACE_TIMEZONE=Asia/Kolkata
